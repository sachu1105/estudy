# Copy to .env for local development. Every variable is validated at boot by
# src/server/env.ts; the app refuses to start if one is missing or malformed.
# Rule 1: nothing AI-related may ever be prefixed NEXT_PUBLIC_.

# --- App ---------------------------------------------------------------------
# Public base URL, used in emails and redirects.
APP_URL=http://localhost:3000
# Timezone used for "today" when a user has not set one.
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Postgres (docker compose service "postgres") ----------------------------
POSTGRES_USER=studyplanner
POSTGRES_PASSWORD=studyplanner
POSTGRES_DB=studyplanner
# Connection string Prisma uses. Must point at the database above.
DATABASE_URL=postgresql://studyplanner:studyplanner@127.0.0.1:5432/studyplanner

# --- Redis (rate limits, BullMQ, pub/sub, rank caches) -----------------------
REDIS_URL=redis://127.0.0.1:6379

# --- Auth --------------------------------------------------------------------
# Secrets for signing JWTs. At least 32 characters each, different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef

# --- Object storage (MinIO locally, Cloudflare R2 or S3 in production) -------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=studyplanner
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# true for MinIO; false for most hosted S3 providers.
S3_FORCE_PATH_STYLE=true
# Optional: the host browsers upload to, if not S3_ENDPOINT (e.g. http://192.168.1.20:9000
# to test uploads from a phone on your Wi-Fi). Production R2/S3 needs a CORS rule allowing
# PUT from APP_URL.
S3_PUBLIC_ENDPOINT=

# --- AI (server and worker only) ---------------------------------------------
# "ollama" for local dev, "hosted" for production.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Small instruct model pulled by the ollama-pull compose service on first run.
OLLAMA_MODEL=qwen2.5:3b-instruct
# Required only when AI_PROVIDER=hosted (Anthropic Messages API by default),
# e.g. AI_MODEL=claude-sonnet-5-5.
AI_API_KEY=
AI_MODEL=
AI_API_URL=
# USD per million tokens, logged per call into AiUsage. 0 for local models.
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
# Parse jobs per worker process. 1 suits a local Ollama model.
WORKER_CONCURRENCY=1

# --- Email (Mailpit locally: inbox at http://localhost:8025) -----------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Leave empty when the SMTP server needs no auth (Mailpit).
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Study planner <no-reply@studyplanner.local>"

# --- Plans -------------------------------------------------------------------
# false at launch: every user resolves to ELITE (CLAUDE.md rule 8).
BILLING_ENABLED=false

# --- Seed --------------------------------------------------------------------
# The SUPER_ADMIN created by pnpm db:seed (milestone 2).
SEED_ADMIN_EMAIL=admin@studyplanner.local
SEED_ADMIN_PASSWORD=change-me-please
