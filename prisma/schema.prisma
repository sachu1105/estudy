// Conventions (CLAUDE.md rule 12): ids are uuid strings, timestamps are timestamptz.
// Append-only tables (rule 6) are protected by triggers in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/server/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum Plan {
  FREE
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SubscriptionSource {
  DEFAULT
  ADMIN_GRANT
  RAZORPAY
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  passwordHash    String
  name            String
  displayName     String
  /// The stable path that serves the photo (/api/profile-image/<id>?...), not a storage
  /// key: every avatar in the app reads this field straight from its query.
  avatarUrl       String?
  /// Storage key behind avatarUrl. Null when the user has no photo (initials show).
  avatarKey       String?
  /// lib/pods/covers storedCoverSchema: a gradient preset, or an image the user uploaded.
  profileCover    Json?
  bio             String?
  /// The public profile's handle: /u/<handle>. Null until sharing is turned on.
  handle          String?    @unique
  /// Off by default: a profile is private until the user chooses to share it.
  profilePublic   Boolean    @default(false)
  role            Role       @default(USER)
  timezone        String     @default("Asia/Kolkata")
  beginnerMode    Boolean    @default(false)
  /// An admin reset the streak (abuse): streaks only count days after this.
  streakResetAt   DateTime?  @db.Timestamptz(6)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  subscriptions      Subscription[]
  auditLogs          AuditLog[]
  syllabusVersions   SyllabusVersion[]   @relation("SyllabusOwner")
  approvedSyllabuses SyllabusVersion[]   @relation("SyllabusApprover")
  parseJobs          ParseJob[]
  aiUsage            AiUsage[]
  pods               Pod[]
  podItems           PodItem[]
  podFiles           PodFile[]
  omrSheets          OmrSheet[]
  topicCompletions   TopicCompletion[]
  planDrafts         PlanDraft[]
  studyAvailability  StudyAvailability?
  examPriorities     ExamPriority[]
  studyPlans         StudyPlan[]
  taskCompletions    TaskCompletion[]
  studySessions      StudySession[]
  activeSession      ActiveSession?
  xpLedger           XpLedger[]
  planOverrides      PlanOverride[]
  questionsCreated   Question[]          @relation("QuestionAuthor")
  questionReports    QuestionReport[]
  mockTests          MockTest[]
  testAttempts       TestAttempt[]
  groupsOwned        Group[]             @relation("GroupOwner")
  memberships        Membership[]
  joinRequests       JoinRequest[]
  groupItems         GroupItem[]
  groupTests         GroupTest[]
  blocks             Block[]             @relation("Blocker")
  blockedBy          Block[]             @relation("Blocked")
  reports            Report[]
  posts              Post[]
  replies            Reply[]
  reactions          Reaction[]
  messages           Message[]
  messageReactions   MessageReaction[]
  pollVotes          PollVote[]
  channelReads       ChannelRead[]
  channelAccess      ChannelAccess[]
  squadPasses        SquadPass[]
  channelNotify      ChannelNotify[]
  notifications      Notification[]      @relation("NotificationFor")
  pushSubscriptions  PushSubscription[]
  notifyPrefs        NotifyPrefs?
  payments           Payment[]
  notificationsSent  Notification[]      @relation("NotificationActor")
  examCovers         ExamCover[]
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque token. The token itself is never stored.
  tokenHash  String    @unique
  /// Every rotation stays in one family; reuse of a rotated token revokes the family.
  familyId   String    @db.Uuid
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  userAgent  String?
  ip         String?

  @@index([familyId])
  @@index([userId])
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
}

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              Plan
  status            SubscriptionStatus @default(ACTIVE)
  periodEnd         DateTime?          @db.Timestamptz(6)
  source            SubscriptionSource @default(DEFAULT)
  /// Razorpay's own id for the subscription, when it came from there (milestone 16).
  providerId        String?            @unique
  /// Payment failed: the plan still works until this passes, then it drops to FREE.
  graceUntil        DateTime?          @db.Timestamptz(6)
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)

  @@index([userId, status])
}

/// What the payment provider told us, kept so a webhook is never applied twice
/// (milestone 16). Append-only.
model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The provider's event id: the idempotency key.
  eventId     String   @unique
  event       String
  providerId  String?
  amountPaise Int?
  payload     Json
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
}

/// A browser that agreed to web push (milestone 16).
model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
}

/// Which of the three reminders a person wants, and when to stay quiet (milestone 16).
model NotifyPrefs {
  userId          String   @id @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionReminder Boolean  @default(true)
  streakAtRisk    Boolean  @default(true)
  weeklySummary   Boolean  @default(true)
  byEmail         Boolean  @default(true)
  byPush          Boolean  @default(true)
  /// Local times, minutes from midnight: when the study window starts, and quiet hours.
  windowStartMin  Int      @default(1140)
  quietFromMin    Int      @default(1320)
  quietToMin      Int      @default(420)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
}

/// One reminder sent to one person on one day: never send the same one twice.
model ReminderLog {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  kind      ReminderKind
  localDate DateTime     @db.Date
  channel   String
  createdAt DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([userId, kind, localDate])
}

enum ReminderKind {
  SESSION
  STREAK
  WEEKLY
}

/// Append-only (rule 6): UPDATE and DELETE are rejected by a database trigger.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  targetId  String?  @db.Uuid
  metadata  Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// --- Milestone 4: catalogue, syllabus upload and AI parsing ---------------------

enum SyllabusStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum SyllabusVisibility {
  PRIVATE
  CATALOGUE
}

enum SourceKind {
  PDF
  DOCX
  IMAGE
  TEXT
}

enum ParseJobStatus {
  QUEUED
  RUNNING
  READY
  FAILED
}

/// What the user sees: queued -> reading -> structuring -> ready (or failed).
enum ParseStage {
  QUEUED
  READING
  STRUCTURING
  READY
  FAILED
}

model Exam {
  groups      Group[]
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  /// "Kerala PSC", "SSC", "RRB"
  board       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  syllabuses SyllabusVersion[]
}

/// One AI parse per distinct file (CLAUDE.md rule 4), shared by every upload of the same
/// bytes. Holds the raw validated AI tree; each upload gets its own editable copy.
model SyllabusParse {
  id            String     @id @default(uuid()) @db.Uuid
  /// SHA-256 (hex) of the uploaded bytes, computed on the server.
  fileHash      String
  sourceKind    SourceKind
  extractedText String
  /// Validated output of the structuring prompt: { subjects: [...] }.
  tree          Json
  provider      String
  model         String
  promptVersion String
  /// Problems the user should know about, e.g. MALAYALAM_GARBLED (old PDF fonts).
  warnings      String[]   @default([])
  /// MinHash of the text, for reusing a near-identical syllabus (another post, same syllabus).
  minhash       Int[]      @default([])
  /// The post from the heading ("LD CLERK [KWA]"), when the syllabus names one.
  post          String?
  /// Set when this parse is a copy of a near-identical one, not an AI result.
  copiedFromId  String?    @db.Uuid
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)

  versions SyllabusVersion[]

  /// Once per file per parser version: a better parser reads a file again, once.
  @@unique([fileHash, promptVersion])
}

/// One structured syllabus section, reused by any later syllabus with the same section text
/// (most PSC syllabuses share Simple Arithmetic, English grammar and so on word for word).
model SectionCache {
  /// Parser version + SHA-256 of the normalised heading and text.
  key       String   @id
  subjects  Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model SyllabusVersion {
  id             String             @id @default(uuid()) @db.Uuid
  title          String
  status         SyllabusStatus     @default(DRAFT)
  visibility     SyllabusVisibility @default(PRIVATE)
  examId         String?            @db.Uuid
  exam           Exam?              @relation(fields: [examId], references: [id], onDelete: SetNull)
  ownerId        String?            @db.Uuid
  owner          User?              @relation("SyllabusOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  fileHash       String?
  sourceFileKey  String?
  sourceKind     SourceKind?
  sourceName     String?
  sizeBytes      Int?
  parseId        String?            @db.Uuid
  parse          SyllabusParse?     @relation(fields: [parseId], references: [id], onDelete: SetNull)
  approvedAt     DateTime?          @db.Timestamptz(6)
  /// Why an admin rejected it, shown with the syllabus.
  reviewNote     String?
  /// A catalogue copy made from a user's (or admin's) confirmed upload.
  promotedFromId String?            @db.Uuid
  approvedById   String?            @db.Uuid
  approvedBy     User?              @relation("SyllabusApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?          @db.Timestamptz(6)

  subjects       Subject[]
  parseJobs      ParseJob[]
  pods           Pod[]
  planDrafts     PlanDraft[]
  studyPlans     StudyPlan[]
  examPriorities ExamPriority[]
  examCovers     ExamCover[]

  @@index([ownerId, deletedAt])
  @@index([visibility, status])
  @@index([fileHash])
}

model Subject {
  id                String          @id @db.Uuid
  syllabusVersionId String          @db.Uuid
  syllabusVersion   SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)
  name              String
  order             Int
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)

  topics Topic[]
  pods   Pod[]

  @@index([syllabusVersionId, order])
}

model Topic {
  id           String   @id @db.Uuid
  subjectId    String   @db.Uuid
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name         String
  /// 1-5: share of the exam's marks.
  weight       Int
  /// 1-5
  difficulty   Int
  /// Basics other topics build on; beginner mode studies these first.
  foundational Boolean  @default(false)
  order        Int
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  items     PodItemTopic[]
  questions Question[]

  @@index([subjectId, order])
}

model ParseJob {
  id                String          @id @default(uuid()) @db.Uuid
  syllabusVersionId String          @db.Uuid
  syllabusVersion   SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)
  userId            String?         @db.Uuid
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  status            ParseJobStatus  @default(QUEUED)
  stage             ParseStage      @default(QUEUED)
  /// 0-100, for the progress bar while structuring several chunks.
  progress          Int             @default(0)
  /// User-facing: what happened and how to fix it.
  error             String?
  attempts          Int             @default(0)
  /// Set when an identical file's parse was reused instead of calling the AI.
  reused            Boolean         @default(false)
  startedAt         DateTime?       @db.Timestamptz(6)
  finishedAt        DateTime?       @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)

  @@index([syllabusVersionId, createdAt])
  @@index([userId, createdAt])
}

/// Tokens and cost of every AI call. Append-only.
model AiUsage {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// What the call was for: STRUCTURE_SYLLABUS, GENERATE_QUESTIONS, SUMMARIZE
  purpose       String
  provider      String
  model         String
  promptVersion String
  /// Job or record the call belongs to, e.g. a ParseJob id.
  refId         String?  @db.Uuid
  inputTokens   Int
  outputTokens  Int
  /// Cost in millionths of a US dollar; 0 for local models.
  costMicros    Int
  durationMs    Int
  ok            Boolean
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([purpose, createdAt])
}

// --- Milestone 5: subject pods --------------------------------------------------

enum PodKind {
  SUBJECT
  CUSTOM
}

enum PodItemType {
  NOTE
  LINK
  FILE
  IMAGE
}

/// For links: fetching title and description. For files: reading the text layer.
enum ItemStatus {
  NONE
  PENDING
  DONE
  FAILED
}

/// A subject's home: its topics, the user's material mapped to them, tests and progress.
/// One per user per syllabus subject, plus CUSTOM pods the user makes.
/// A subject's column on the exam board.
enum PodStage {
  TO_STUDY
  STUDYING
  REVISING
  DONE
}

model Pod {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @db.Uuid
  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind              PodKind
  name              String
  syllabusVersionId String?          @db.Uuid
  syllabusVersion   SyllabusVersion? @relation(fields: [syllabusVersionId], references: [id], onDelete: SetNull)
  /// Removing the subject from the syllabus keeps the pod and its material; it turns custom.
  subjectId         String?          @db.Uuid
  subject           Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  order             Int              @default(0)
  /// Where the user put it on the exam's board; the plan reads it (rule 14 override).
  stage             PodStage         @default(TO_STUDY)
  /// Position within its board column, top first.
  stageOrder        Int              @default(0)
  /// The card's cover as the user chose it (lib/pods/covers storedCoverSchema); null
  /// means automatic, a gradient picked from the id.
  cover             Json?
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?        @db.Timestamptz(6)

  items PodItem[]

  @@unique([ownerId, subjectId])
  @@index([ownerId, deletedAt])
}

model PodItem {
  id              String      @id @default(uuid()) @db.Uuid
  podId           String      @db.Uuid
  pod             Pod         @relation(fields: [podId], references: [id], onDelete: Cascade)
  ownerId         String      @db.Uuid
  owner           User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type            PodItemType
  title           String
  /// NOTE: the editor document, and its plain text for search.
  noteJson        Json?
  noteText        String?
  /// LINK
  url             String?
  linkDescription String?
  faviconUrl      String?
  /// FILE and IMAGE: total of the files; the text layer once read.
  sizeBytes       Int         @default(0)
  pageCount       Int?
  extractedText   String?
  status          ItemStatus  @default(NONE)
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(6)
  /// In the trash: restorable for 30 days, then purged with its files.
  deletedAt       DateTime?   @db.Timestamptz(6)

  files  PodFile[]
  topics PodItemTopic[]

  @@index([podId, deletedAt, createdAt])
  @@index([ownerId, deletedAt])
}

/// A stored file: the PDF of a FILE item, each page photo of an IMAGE item, or an image
/// placed inside a NOTE. Served only through /api/pods/files/[id] (ownership + signed URL).
model PodFile {
  id         String   @id @default(uuid()) @db.Uuid
  itemId     String   @db.Uuid
  item       PodItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ownerId    String   @db.Uuid
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  sha256     String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([itemId, order])
}

/// A question paper the user uploaded as a PDF, with an OMR sheet they mark beside it.
/// Private to its owner (rule 15). `marks` holds one entry per question: -1 for blank,
/// 0-3 for A-D.
model OmrSheet {
  id                String    @id @default(uuid()) @db.Uuid
  ownerId           String    @db.Uuid
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  storageKey        String    @unique
  sizeBytes         Int
  sha256            String
  pageCount         Int?
  marks             Int[]
  /// The timer (lib/omr/timer): on once started; a limit counts down, none counts up.
  /// Time runs from `timerRunningSince` on the server's clock, on top of
  /// `timerElapsedSec` banked by earlier runs; paused, `timerRunningSince` is null.
  timerOn           Boolean   @default(false)
  timerLimitSec     Int?
  timerElapsedSec   Int       @default(0)
  timerRunningSince DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@index([ownerId, createdAt])
}

/// Which topics an item covers. One item can cover several topics.
model PodItemTopic {
  itemId  String  @db.Uuid
  item    PodItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  topicId String  @db.Uuid
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([itemId, topicId])
  @@index([topicId])
}

/// Append-only (rule 6): each tick or untick of a topic. The latest row is the state.
/// topicId has no foreign key, so history outlives a topic removed from the syllabus.
model TopicCompletion {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  topicId   String   @db.Uuid
  done      Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, topicId, createdAt])
}

// ---------------------------------------------------------------------------------------
// Study plans (milestone 6). Built from an exam's pods by the deterministic plan engine.

enum StudyPlanStatus {
  ACTIVE
  ARCHIVED
  /// The user set this exam aside. The plan, its tasks and everything logged against them
  /// stay; it simply stops being ACTIVE, which is what takes it off Today, the calendar and
  /// the mock strip without a single query changing. Resuming builds a fresh plan from it.
  PAUSED
}

/// What an exam is to the user right now. Exactly one exam is the FOCUS: it leads Today and
/// takes the larger share of the day (lib/plans/shares).
enum ExamRole {
  FOCUS
  ALONGSIDE
  PAUSED
}

/// How one user ranks one exam. Kept apart from StudyPlan because a pause has to outlive the
/// plan it paused, an exam pod can exist before any plan does, and every re-plan writes a new
/// StudyPlan row that a role would have to be copied onto. No row means ALONGSIDE.
model ExamPriority {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  syllabusVersionId String          @db.Uuid
  syllabusVersion   SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)
  role              ExamRole        @default(ALONGSIDE)
  /// A share of the day the user pinned by hand (rule 14). Null means derived from the roles.
  sharePercent      Int?
  /// When it was paused. The days spent paused are added to the plan's timelineStart on
  /// resume, so a pause never eats the learning days out of the final review window.
  pausedAt          DateTime?       @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)

  @@unique([userId, syllabusVersionId])
  @@index([userId, role])
}

enum PlanTaskType {
  STUDY
  REVISION
  CHECK_TEST
  SECTION_MOCK
  FULL_MOCK
  CUSTOM
}

enum TimeWindow {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum PlanPhase {
  LEARN
  REVIEW
}

/// The study time the user has, shared by every exam they are preparing for. One row per
/// user, created the first time they set it up; no row means the defaults. Each exam's plan
/// is built from a slice of this (lib/plans/shares), so two plans can never book the same
/// minute twice. The copy inside PlanDraft.data is a cache of this, never the source.
model StudyAvailability {
  userId           String       @id @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Minutes available on each weekday, Sunday first, like the engine.
  minutesByWeekday Int[]
  /// In the user's order of preference; the earliest window goes to weak topics.
  preferredWindows TimeWindow[]
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)
}

/// The plan's setup steps, autosaved so back never loses anything. One per exam.
model PlanDraft {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  syllabusVersionId String          @db.Uuid
  syllabusVersion   SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)
  /// Parsed with planDraftSchema on every read and write.
  data              Json
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)

  @@unique([userId, syllabusVersionId])
}

model StudyPlan {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  syllabusVersionId String?          @db.Uuid
  syllabusVersion   SyllabusVersion? @relation(fields: [syllabusVersionId], references: [id], onDelete: SetNull)
  title             String
  status            StudyPlanStatus  @default(ACTIVE)
  startDate         DateTime         @db.Date
  endDate           DateTime         @db.Date
  reviewStartDate   DateTime?        @db.Date
  /// The engine input exactly as run, with subject and topic names: later pod or syllabus
  /// edits never rewrite a plan.
  inputs            Json
  /// Topics left out to fit the time ("accept partial coverage"), with names.
  leftOut           Json             @default("[]")
  availableMinutes  Int
  requiredMinutes   Int
  plannedMinutes    Int
  /// SNAPSHOT, NOT STATE. The role and share of the day this plan was built with, for the
  /// "Why this?" screens and for an archived plan's own story. Never read these to find out
  /// what an exam is now: that is ExamPriority.
  role              ExamRole?
  sharePercent      Int?
  /// Per-topic confidence changes from the last re-plan, fed into the next one.
  adjustments       Json             @default("[]")
  /// What the re-plan that made this plan changed; shown once as a card.
  replanDiff        Json?
  diffSeenAt        DateTime?        @db.Timestamptz(6)
  /// Set when a re-plan found the rest no longer fits; the plan itself is kept.
  replanWarning     Json?
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)

  days  PlanDay[]
  tasks PlanTask[]

  @@index([userId, status])
}

model PlanDay {
  id              String    @id @default(uuid()) @db.Uuid
  planId          String    @db.Uuid
  plan            StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  date            DateTime  @db.Date
  weekday         Int
  phase           PlanPhase
  capacityMinutes Int
  plannedMinutes  Int
  leadSubjectId   String?   @db.Uuid

  tasks PlanTask[]

  @@unique([planId, date])
}

model PlanTask {
  id          String       @id @default(uuid()) @db.Uuid
  planId      String       @db.Uuid
  plan        StudyPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayId       String       @db.Uuid
  day         PlanDay      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  /// The engine's own id for the task; overrides refer to it.
  key         String
  position    Int
  type        PlanTaskType
  date        DateTime     @db.Date
  /// Snapshot ids: no foreign keys, so a syllabus edit can't break a plan.
  subjectId   String?      @db.Uuid
  topicId     String?      @db.Uuid
  minutes     Int
  window      TimeWindow
  partIndex   Int?
  partTotal   Int?
  touch       Int?
  finalReview Boolean      @default(false)
  pinned      Boolean      @default(false)
  title       String?
  /// "Why this?" (rule 14), as the engine returned it.
  reason      Json

  @@unique([planId, key])
  @@index([planId, date])
}

// ---------------------------------------------------------------------------------------
// Progress (milestone 7). The four logs are append-only (rule 6); streaks, XP totals and
// progress are derived from them.

enum XpKind {
  STUDY
  TASK
  STREAK
  TEST
  /// An answer the asker accepted in a group (milestone 14).
  ANSWER
}

enum OverrideKind {
  MOVE
  RESIZE
  LOCK
  CUSTOM
}

/// A task ticked (done) or unticked (not done). The latest row per task wins.
model TaskCompletion {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Snapshot references: plans are re-made weekly, the log outlives them.
  planId    String       @db.Uuid
  taskId    String       @db.Uuid
  taskKey   String
  type      PlanTaskType
  subjectId String?      @db.Uuid
  topicId   String?      @db.Uuid
  minutes   Int
  /// The user's calendar day when it happened.
  localDate DateTime     @db.Date
  done      Boolean
  /// CHECK_TEST and mocks: fraction correct (0-1), for the re-plan.
  accuracy  Float?
  createdAt DateTime     @default(now()) @db.Timestamptz(6)

  @@index([userId, taskId, createdAt])
  @@index([userId, localDate])
}

/// A finished stretch of focused study. Only active minutes count (heartbeats).
model StudySession {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId        String?  @db.Uuid
  taskId        String?  @db.Uuid
  subjectId     String?  @db.Uuid
  topicId       String?  @db.Uuid
  startedAt     DateTime @db.Timestamptz(6)
  endedAt       DateTime @db.Timestamptz(6)
  activeMinutes Int
  localDate     DateTime @db.Date
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, localDate])
}

/// The timer that's running now, one per user. Live state, not a log.
model ActiveSession {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String   @db.Uuid
  taskId        String   @db.Uuid
  startedAt     DateTime @db.Timestamptz(6)
  lastBeatAt    DateTime @db.Timestamptz(6)
  activeSeconds Int      @default(0)
  paused        Boolean  @default(false)
}

model XpLedger {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind      XpKind
  amount    Int
  /// The task or session it came from.
  refId     String?  @db.Uuid
  localDate DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, localDate])
}

/// A hand edit to a plan (rule 14), kept per exam so every re-plan respects it.
/// "Reset to suggested" removes it.
model PlanOverride {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  syllabusVersionId String       @db.Uuid
  taskKey           String
  kind              OverrideKind
  /// A pin override as the plan engine reads it (pinOverrideSchema).
  data              Json
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([userId, syllabusVersionId, taskKey])
}

// ---------------------------------------------------------------------------------------
// Admin (milestone 15)

/// Settings the admin changes at runtime: entitlement limits, billing switch,
/// announcement banner, maintenance mode, feature flags. Each value is zod-parsed on read.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
}

// ---------------------------------------------------------------------------------------
// Mock tests (milestone 8). Practice questions, not official ones. Every question passes a
// human gate before anyone else sees it (rule 5).

enum QuestionStatus {
  PENDING
  VERIFIED
  SUPPRESSED
}

enum QuestionSource {
  AI
  PYQ
  ADMIN
  USER
  MATERIAL
}

enum QuestionLanguage {
  EN
  ML
}

enum ReportReason {
  WRONG_ANSWER
  UNCLEAR
  TYPO
  OTHER
}

enum MockTestType {
  CHECK
  SECTION
  FULL
  CUSTOM
  MATERIAL
}

model Question {
  id           String           @id @default(uuid()) @db.Uuid
  /// The catalogue topic it was written for, if any.
  topicId      String?          @db.Uuid
  topic        Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  /// Normalised topic name: the same topic in another syllabus finds these questions too.
  topicKey     String
  difficulty   Int
  language     QuestionLanguage @default(EN)
  body         String
  /// Exactly four options.
  options      String[]
  correctIndex Int
  explanation  String?
  status       QuestionStatus   @default(PENDING)
  source       QuestionSource
  /// Where it came from: a paper and year, a note, a book.
  sourceRef    String?
  reportCount  Int              @default(0)
  createdById  String?          @db.Uuid
  createdBy    User?            @relation("QuestionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  verifiedById String?          @db.Uuid
  verifiedAt   DateTime?        @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  reports QuestionReport[]

  @@index([topicKey, status])
  @@index([topicId, status])
  @@index([status, reportCount])
}

model QuestionReport {
  id         String       @id @default(uuid()) @db.Uuid
  questionId String       @db.Uuid
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String       @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     ReportReason
  note       String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime?    @db.Timestamptz(6)

  @@unique([questionId, userId])
}

/// A test made for one user: the questions picked, in order. Picked once, never reshuffled.
model MockTest {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              MockTestType
  title             String
  syllabusVersionId String?      @db.Uuid
  subjectId         String?      @db.Uuid
  topicId           String?      @db.Uuid
  /// The plan task it belongs to (a check test, section mock or full mock).
  planTaskId        String?      @db.Uuid
  questionIds       String[]     @db.Uuid
  /// null: untimed.
  durationSec       Int?
  /// PSC style: a third of a mark off for each wrong answer.
  negativeMarking   Boolean      @default(false)
  /// Set when the user first opens it; the timer counts from here.
  startedAt         DateTime?    @db.Timestamptz(6)
  /// A member's copy of a test shared in a group (milestone 13).
  groupTestId       String?      @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)

  attempts TestAttempt[]

  @@index([userId, createdAt])
  @@index([userId, planTaskId])
}

/// A submitted test, scored on the server. Append-only (rule 6).
model TestAttempt {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  mockTestId  String       @db.Uuid
  mockTest    MockTest     @relation(fields: [mockTestId], references: [id], onDelete: Restrict)
  type        MockTestType
  subjectId   String?      @db.Uuid
  topicId     String?      @db.Uuid
  total       Int
  correct     Int
  wrong       Int
  skipped     Int
  /// Marks after any negative marking.
  score       Float
  /// correct / total, 0-1.
  accuracy    Float
  durationSec Int
  localDate   DateTime     @db.Date
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)

  answers AttemptAnswer[]

  @@index([userId, createdAt])
  @@index([userId, topicId])
}

model AttemptAnswer {
  id          String      @id @default(uuid()) @db.Uuid
  attemptId   String      @db.Uuid
  attempt     TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  questionId  String      @db.Uuid
  topicKey    String
  position    Int
  chosenIndex Int?
  correct     Boolean
  flagged     Boolean     @default(false)

  @@index([attemptId, position])
}

// ---------------------------------------------------------------------------------------
// Groups (milestone 13). Every action checks membership and group role (rule 9).

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupRole {
  OWNER
  ADMIN
  /// Keeps the peace: hides and deletes content, mutes members. Runs nothing else.
  MODERATOR
  MEMBER
}

/// How people get into a squad. A private squad is never OPEN: it asks or needs an invite.
enum SquadJoinMode {
  OPEN
  REQUEST
  INVITE_ONLY
}

/// What a channel holds. Each type is one of the squad's features.
enum ChannelType {
  CHAT
  THREADS
  MATERIAL
  LINKS
  TESTS
  ANNOUNCEMENTS
}

/// Who may post in a channel. Everyone reads what they can see.
enum ChannelPostRule {
  EVERYONE
  ADMINS
}

/// Who may open a channel at all (squads S5).
enum ChannelViewRule {
  EVERYONE
  /// The squad's owner, admins and moderators.
  ADMINS
  /// Those, plus the people listed in ChannelAccess.
  PICKED
}

/// How much of a channel reaches one person.
enum NotifyLevel {
  ALL
  MENTIONS
  MUTE
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ReportTarget {
  GROUP
  GROUP_ITEM
  GROUP_TEST
  USER
  POST
  REPLY
  MESSAGE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Group {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  /// lib/pods/covers storedCoverSchema: the squad's banner. Null means automatic.
  cover        Json?
  examId       String?         @db.Uuid
  exam         Exam?           @relation(fields: [examId], references: [id], onDelete: SetNull)
  visibility   GroupVisibility @default(PUBLIC)
  joinMode     SquadJoinMode   @default(OPEN)
  /// Asked of people who request to join, when the squad asks.
  joinQuestion String?
  ownerId      String          @db.Uuid
  owner        User            @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// A site admin took it out of the directory (moderation).
  hiddenAt     DateTime?       @db.Timestamptz(6)
  /// What one pass costs, in paise. Null: a free squad. Only the owner sets it.
  pricePaise   Int?
  /// How long one payment lets a member in. Null: for good.
  accessDays   Int?
  /// What a member gets for the price, shown above the pay button.
  offer        String?
  /// A sample class to watch before paying.
  demoUrl      String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?       @db.Timestamptz(6)

  members    Membership[]
  passes     SquadPass[]
  invites    GroupInvite[]
  requests   JoinRequest[]
  items      GroupItem[]
  tests      GroupTest[]
  posts      Post[]
  categories ChannelCategory[]
  channels   Channel[]
  messages   Message[]

  @@index([visibility, deletedAt, examId])
}

/// A heading that groups a squad's channels, like "Library".
model ChannelCategory {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  channels Channel[]

  @@index([groupId, order])
}

/// One channel in a squad: chat, threads, material, links, tests or announcements.
model Channel {
  id          String           @id @default(uuid()) @db.Uuid
  groupId     String           @db.Uuid
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// No category: listed above the categories.
  categoryId  String?          @db.Uuid
  category    ChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type        ChannelType
  /// Lower case, words joined with hyphens: "mock-tests".
  name        String
  /// A line under the name: what the channel is for.
  topic       String?
  order       Int              @default(0)
  postRule    ChannelPostRule  @default(EVERYONE)
  viewRule    ChannelViewRule  @default(EVERYONE)
  /// The syllabus subject this channel is for: what's posted here is tagged with it.
  subjectName String?
  /// Seconds a member waits between messages here. 0 is off; admins are exempt.
  slowModeSec Int              @default(0)
  /// A paid channel: members unlock it with a pass. Null: free to every member.
  pricePaise  Int?
  /// How long one pass to it lasts. Null: for good.
  accessDays  Int?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?        @db.Timestamptz(6)

  items    GroupItem[]
  tests    GroupTest[]
  posts    Post[]
  messages Message[]
  reads    ChannelRead[]
  access   ChannelAccess[]
  notify   ChannelNotify[]
  passes   SquadPass[]

  @@index([groupId, deletedAt, order])
}

/// One person let into a PICKED channel (squads S5).
model ChannelAccess {
  id        String   @id @default(uuid()) @db.Uuid
  channelId String   @db.Uuid
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([channelId, userId])
  @@index([userId])
}

/// How much of one channel reaches one person. No row means everything.
model ChannelNotify {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String      @db.Uuid
  channel   Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  level     NotifyLevel

  @@unique([userId, channelId])
}

/// A message in a chat or announcements channel (squads S3). Editable by its author.
model Message {
  id               String      @id @default(uuid()) @db.Uuid
  groupId          String      @db.Uuid
  group            Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channelId        String      @db.Uuid
  channel          Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId         String      @db.Uuid
  author           User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Markdown subset, rendered without HTML.
  body             String
  /// The message this answers, shown above it.
  replyToId        String?     @db.Uuid
  replyTo          Message?    @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  answers          Message[]   @relation("MessageReply")
  /// People named with @, checked to be members when sent.
  mentionIds       String[]    @db.Uuid
  /// A pod item shared into the chat: a copy, like any shared material (rule 15).
  itemId           String?     @db.Uuid
  item             GroupItem?  @relation(fields: [itemId], references: [id], onDelete: SetNull)
  /// A plain message, a doubt for others to answer (replies), or a poll.
  kind             MessageKind @default(TEXT)
  /// A mock test shared into the chat; members take it from the message.
  groupTestId      String?     @db.Uuid
  groupTest        GroupTest?  @relation(fields: [groupTestId], references: [id], onDelete: SetNull)
  /// On a doubt: the reply its asker marked as the best answer.
  acceptedAnswerId String?     @db.Uuid
  acceptedAnswer   Message?    @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)
  acceptedFor      Message[]   @relation("AcceptedAnswer")
  editedAt         DateTime?   @db.Timestamptz(6)
  /// A squad admin or site admin took it down.
  hiddenAt         DateTime?   @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  deletedAt        DateTime?   @db.Timestamptz(6)

  reactions   MessageReaction[]
  pollOptions PollOption[]
  pollVotes   PollVote[]

  @@index([channelId, createdAt])
  @@index([groupId, createdAt])
}

enum MessageKind {
  TEXT
  DOUBT
  POLL
}

/// One choice of a poll in a chat message, in order.
model PollOption {
  id        String     @id @default(uuid()) @db.Uuid
  messageId String     @db.Uuid
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  order     Int
  text      String
  votes     PollVote[]

  @@index([messageId, order])
}

/// A member's vote on a poll: one each, which they can change or take back.
model PollVote {
  id        String     @id @default(uuid()) @db.Uuid
  messageId String     @db.Uuid
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  optionId  String     @db.Uuid
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)

  @@unique([messageId, userId])
  @@index([optionId])
}

model MessageReaction {
  id        String       @id @default(uuid()) @db.Uuid
  messageId String       @db.Uuid
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ReactionKind
  createdAt DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([messageId, userId, kind])
}

/// How far one person has read a channel: newer messages show as unread.
model ChannelRead {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId  String   @db.Uuid
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @db.Timestamptz(6)

  @@unique([userId, channelId])
}

model Membership {
  id         String    @id @default(uuid()) @db.Uuid
  groupId    String    @db.Uuid
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       GroupRole @default(MEMBER)
  /// Muted members read but can't share until this passes.
  mutedUntil DateTime? @db.Timestamptz(6)
  /// In a paid squad, a member's pass runs out then. Null: no end (paid for good, or
  /// let in by an invite). Owners, admins and moderators never run out.
  paidUntil  DateTime? @db.Timestamptz(6)
  joinedAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([groupId, userId])
  @@index([userId])
}

/// Who paid for what. Payments are demo-only until Razorpay arrives: no money moves.
enum PassProvider {
  DEMO
  RAZORPAY
}

/// One payment for a paid squad, or for a paid channel in a squad. Append-only (rule 6):
/// renewing writes a new row, and access is read from the latest.
model SquadPass {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String       @db.Uuid
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Null: the squad itself. Set: one paid channel in it.
  channelId   String?      @db.Uuid
  channel     Channel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  amountPaise Int
  provider    PassProvider
  /// The provider's payment id: the idempotency key once payments are real.
  providerRef String       @unique
  /// When access ends. Null: for good.
  accessUntil DateTime?    @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)

  @@index([userId, groupId, channelId, createdAt])
  @@index([groupId, createdAt])
}

model GroupInvite {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @db.Uuid
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Typed in, or in a link: /groups/join/<code>.
  code        String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime? @db.Timestamptz(6)
  maxUses     Int?
  uses        Int       @default(0)
  revokedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([groupId])
}

model JoinRequest {
  id          String            @id @default(uuid()) @db.Uuid
  groupId     String            @db.Uuid
  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      JoinRequestStatus @default(PENDING)
  /// The answer to the squad's join question.
  answer      String?
  decidedById String?           @db.Uuid
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  decidedAt   DateTime?         @db.Timestamptz(6)

  @@unique([groupId, userId])
}

/// Material shared into a group: a copy, so the sharer's pod stays private (rule 15).
model GroupItem {
  id              String      @id @default(uuid()) @db.Uuid
  groupId         String      @db.Uuid
  group           Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channelId       String      @db.Uuid
  channel         Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sharedById      String      @db.Uuid
  sharedBy        User        @relation(fields: [sharedById], references: [id], onDelete: Cascade)
  type            PodItemType
  title           String
  noteJson        Json?
  noteText        String?
  url             String?
  linkDescription String?
  /// Tags: the subject and topic it is for.
  subjectName     String?
  topicName       String?
  sizeBytes       Int         @default(0)
  /// A group admin or site admin took it down.
  hiddenAt        DateTime?   @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  deletedAt       DateTime?   @db.Timestamptz(6)

  files    GroupItemFile[]
  messages Message[]

  @@index([groupId, deletedAt, createdAt])
  @@index([channelId, deletedAt, createdAt])
}

model GroupItemFile {
  id         String    @id @default(uuid()) @db.Uuid
  itemId     String    @db.Uuid
  item       GroupItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order      Int       @default(0)
  storageKey String    @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([itemId, order])
}

/// A test shared in a group. Each member who takes it gets their own MockTest copy.
model GroupTest {
  id              String    @id @default(uuid()) @db.Uuid
  groupId         String    @db.Uuid
  group           Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channelId       String    @db.Uuid
  channel         Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sharedById      String    @db.Uuid
  sharedBy        User      @relation(fields: [sharedById], references: [id], onDelete: Cascade)
  title           String
  questionIds     String[]  @db.Uuid
  durationSec     Int?
  negativeMarking Boolean   @default(false)
  hiddenAt        DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  /// Chat messages that carry it.
  messages        Message[]

  @@index([groupId, createdAt])
  @@index([channelId, createdAt])
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @db.Uuid
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([blockerId, blockedId])
}

/// A report on user content, for the site admins' queue.
model Report {
  id           String       @id @default(uuid()) @db.Uuid
  reporterId   String       @db.Uuid
  reporter     User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTarget
  targetId     String       @db.Uuid
  groupId      String?      @db.Uuid
  reason       String
  note         String?
  status       ReportStatus @default(OPEN)
  resolvedById String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  resolvedAt   DateTime?    @db.Timestamptz(6)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------------------
// Group discussion and questions (milestone 14).

enum PostKind {
  DISCUSSION
  QUESTION
}

enum ReactionKind {
  LIKE
  HELPFUL
  THANKS
}

enum NotificationKind {
  MENTION
  REPLY
  ACCEPTED
  GROUP_TEST
  /// Something in a squad was reported; sent to its owner, admins and moderators.
  REPORT
}

/// A thread in a group: a discussion, or a question tagged with a topic.
model Post {
  id              String    @id @default(uuid()) @db.Uuid
  groupId         String    @db.Uuid
  group           Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channelId       String    @db.Uuid
  channel         Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId        String    @db.Uuid
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind            PostKind  @default(DISCUSSION)
  title           String
  /// Markdown subset, rendered without HTML.
  body            String
  /// People named with @, checked to be members when posted.
  mentionIds      String[]  @db.Uuid
  subjectName     String?
  topicName       String?
  acceptedReplyId String?   @db.Uuid
  pinnedAt        DateTime? @db.Timestamptz(6)
  /// A group admin or site admin took it down.
  hiddenAt        DateTime? @db.Timestamptz(6)
  replyCount      Int       @default(0)
  lastActivityAt  DateTime  @default(now()) @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  replies Reply[]

  @@index([groupId, deletedAt, lastActivityAt])
  @@index([channelId, deletedAt, lastActivityAt])
}

model Reply {
  id         String    @id @default(uuid()) @db.Uuid
  postId     String    @db.Uuid
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   String    @db.Uuid
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  mentionIds String[]  @db.Uuid
  hiddenAt   DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)

  @@index([postId, createdAt])
}

/// One person's reaction of one kind to a post or a reply.
model Reaction {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The post, or the reply's post: one lookup loads a whole thread's reactions.
  postId    String       @db.Uuid
  replyId   String?      @db.Uuid
  /// postId for the post itself, else the replyId; makes the unique key work.
  targetId  String       @db.Uuid
  kind      ReactionKind
  createdAt DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([userId, targetId, kind])
  @@index([postId])
}

/// The in-app notification centre.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation("NotificationFor", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?          @db.Uuid
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  kind      NotificationKind
  groupId   String?          @db.Uuid
  /// Where it leads, relative to the app.
  href      String
  /// A short line: the post title or test name.
  subject   String
  readAt    DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  @@index([userId, readAt, createdAt])
}

/// An exam pod's cover, per user. An exam pod is the user's subject pods for one
/// syllabus rather than a row of its own, so its cover lives here.
model ExamCover {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  syllabusVersionId String          @db.Uuid
  syllabusVersion   SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)
  /// lib/pods/covers storedCoverSchema.
  cover             Json
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)

  @@unique([userId, syllabusVersionId])
}
